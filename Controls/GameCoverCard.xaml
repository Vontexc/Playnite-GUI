<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:swc="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">

    <!-- Converter declared locally so this dictionary is self-contained. -->
    <swc:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- ============================================================
         GameCoverCard – Steam capsule (2:3 vertical) with hover Glow
         + scale + game-name overlay. Used by LibraryView's ItemsControl.

         Bindings:
           {Binding Name}             - game title (TargetNullValue safe)
           {Binding CoverImage}       - cover image source (Playnite resolves)
           {Binding Platforms}        - first platform shown as chip
           {Binding IsInstalled}      - installed badge

         Hover animations driven by VisualStateManager (no code-behind).
         ============================================================ -->

    <Style x:Key="GameCoverCardStyle" TargetType="ContentControl">
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="300" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid x:Name="Root">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="CardScale" CenterX="100" CenterY="150" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <!-- Card surface -->
                        <Border x:Name="CardSurface"
                                Background="{DynamicResource BgPanelBrush}"
                                CornerRadius="{StaticResource CornerRadiusMedium}"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Cover image, fills the card; placeholder when null -->
                                <Image Source="{Binding CoverImage,
                                                        TargetNullValue={x:Null},
                                                        FallbackValue={x:Null}}"
                                       Stretch="UniformToFill" />

                                <!-- Vector placeholder when no cover (from Styles/Placeholders.xaml) -->
                                <ContentControl ContentTemplate="{StaticResource MissingCoverPlaceholderTemplate}"
                                                Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <!-- Bottom gradient overlay (always visible, deepens on hover) -->
                                <Border x:Name="BottomGradient"
                                        VerticalAlignment="Bottom"
                                        Height="120"
                                        Opacity="0.85">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#001B2838" Offset="0.0" />
                                            <GradientStop Color="{StaticResource GradientBottomColor}" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Title overlay - shown only on hover -->
                                <Border x:Name="TitleOverlay"
                                        VerticalAlignment="Bottom"
                                        Padding="12,10,12,12"
                                        Opacity="0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name, TargetNullValue='Unknown', FallbackValue='Unknown'}"
                                                   Style="{StaticResource H3TextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ItemsControl ItemsSource="{Binding Platforms}"
                                                      Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource TagChipStyle}">
                                                        <TextBlock Text="{Binding Name, FallbackValue=''}"
                                                                   Style="{StaticResource CaptionTextStyle}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Installed badge (top-right) -->
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,8,8,0"
                                        Padding="6,2,6,2"
                                        CornerRadius="{StaticResource CornerRadiusSmall}"
                                        Background="{DynamicResource AccentGreenBrush}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <TextBlock Text="INSTALLED"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource TextOnAccentBrush}"
                                               FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Glow border on hover -->
                        <Border x:Name="GlowBorder"
                                CornerRadius="{StaticResource CornerRadiusMedium}"
                                BorderBrush="{DynamicResource AccentBlueBrush}"
                                BorderThickness="2"
                                Opacity="0"
                                IsHitTestVisible="False" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="GlowBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="TitleOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.04" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.04" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="GlowBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="TitleOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.98" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.98" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Glow shadow on hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardSurface" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="22"
                                                      ShadowDepth="0"
                                                      Opacity="0.85"
                                                      Color="{StaticResource AccentBlueColor}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataTemplate wrapper – this is what ItemsControl.ItemTemplate consumes. -->
    <DataTemplate x:Key="GameCoverCardTemplate">
        <ContentControl Style="{StaticResource GameCoverCardStyle}"
                        Content="{Binding}" />
    </DataTemplate>

</ResourceDictionary>
