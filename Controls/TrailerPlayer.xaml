<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         TrailerPlayer – plays a local MP4 trailer if available, falls
         back to BackgroundImage as a still hero.

         Bindings (FallbackValue-safe):
           {Binding Game.BackgroundImage}      – fallback still
           {Binding Game.TrailerVideoPath}     – local mp4 (Companion
                                                 plugin maps extramedia)

         Mute is driven by a ToggleButton via element binding —
         no code-behind. Auto-play via LoadedBehavior=Play.

         Limitations (intentional, since themes ship no .cs):
         - Looping requires code-behind in WPF; the trailer plays once.
           A future Companion plugin attached behavior can rewind on
           MediaEnded.
         - WPF MediaElement requires Windows Media Foundation; H.264
           mp4 is the safe codec. WebM is unsupported.
         ============================================================ -->

    <ControlTemplate x:Key="TrailerPlayerTemplate" TargetType="ContentControl">
        <Grid ClipToBounds="True">
            <!-- Background still: always rendered behind the trailer. -->
            <Image Source="{Binding Game.BackgroundImage,
                                    FallbackValue={x:Null},
                                    TargetNullValue={x:Null}}"
                   Stretch="UniformToFill" />

            <!-- Trailer overlays the still when path is set. -->
            <MediaElement x:Name="Trailer"
                          Source="{Binding Game.TrailerVideoPath,
                                           FallbackValue={x:Null},
                                           TargetNullValue={x:Null}}"
                          LoadedBehavior="Play"
                          UnloadedBehavior="Stop"
                          Stretch="UniformToFill"
                          ScrubbingEnabled="False"
                          IsMuted="{Binding ElementName=MuteToggle, Path=IsChecked, FallbackValue=True}">
                <MediaElement.Style>
                    <Style TargetType="MediaElement">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Game.TrailerVideoPath,
                                                           FallbackValue={x:Null},
                                                           TargetNullValue={x:Null}}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MediaElement.Style>
            </MediaElement>

            <!-- Bottom hero gradient for legibility. -->
            <Rectangle VerticalAlignment="Bottom"
                       Height="200"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#001B2838" Offset="0.0" />
                        <GradientStop Color="{StaticResource GradientBottomColor}" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Mute toggle (top-right). Visible only when trailer path exists.
                 IsChecked=True ⇒ muted; the ToggleButton swaps glyphs via
                 Triggers below. -->
            <ToggleButton x:Name="MuteToggle"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,12,12,0"
                          Width="38" Height="38"
                          IsChecked="True">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource IconButtonStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Content" Value="🔇" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Content" Value="🔊" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Game.TrailerVideoPath,
                                                           FallbackValue={x:Null},
                                                           TargetNullValue={x:Null}}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </Grid>
    </ControlTemplate>

    <Style x:Key="TrailerPlayerStyle" TargetType="ContentControl">
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template" Value="{StaticResource TrailerPlayerTemplate}" />
    </Style>

</ResourceDictionary>
