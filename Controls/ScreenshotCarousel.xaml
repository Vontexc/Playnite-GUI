<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         ScreenshotCarousel – horizontal scroller of thumbnail images.

         DataContext: an IEnumerable<string> (image source paths).
         The hosting view (GameDetails) is responsible for assembling
         that list (e.g. BackgroundImage + extra-images from a Companion
         plugin). When the source is null/empty the carousel hides itself.
         ============================================================ -->

    <Style x:Key="ScreenshotThumbStyle" TargetType="Border">
        <Setter Property="Width" Value="220" />
        <Setter Property="Height" Value="124" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="14"
                                          ShadowDepth="0"
                                          Opacity="0.7"
                                          Color="{StaticResource AccentBlueColor}" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ScreenshotThumbTemplate">
        <Border Style="{StaticResource ScreenshotThumbStyle}">
            <Image Source="{Binding}"
                   Stretch="UniformToFill" />
        </Border>
    </DataTemplate>

    <ControlTemplate x:Key="ScreenshotCarouselTemplate" TargetType="ContentControl">
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly">
                <ItemsControl ItemsSource="{Binding,
                                                    FallbackValue={x:Null},
                                                    TargetNullValue={x:Null}}"
                              ItemTemplate="{StaticResource ScreenshotThumbTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </ControlTemplate>

    <Style x:Key="ScreenshotCarouselStyle" TargetType="ContentControl">
        <Setter Property="Height" Value="140" />
        <Setter Property="Template" Value="{StaticResource ScreenshotCarouselTemplate}" />
    </Style>

</ResourceDictionary>
