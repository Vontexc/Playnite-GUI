<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         GameDetails – Steam-style game detail surface.
         Vertical layout (top → bottom):
           1. Hero (Trailer / Background) with cover + title overlay
           2. Action bar (Play, Install, Edit, More)
           3. HowLongToBeat 3-card panel
           4. Description (collapsible via Expander)
           5. Screenshot carousel
           6. Details grid (genres, platforms, developers, playtime, …)

         All bindings carry FallbackValue / TargetNullValue so the view
         renders when fields are missing or the model is detached.
         ============================================================ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Controls/TrailerPlayer.xaml" />
        <ResourceDictionary Source="../Controls/HltbPanel.xaml" />
        <ResourceDictionary Source="../Controls/ScreenshotCarousel.xaml" />
        <ResourceDictionary Source="../Converters/NullToVisibilityConverter.xaml" />
        <ResourceDictionary Source="../Converters/PlaytimeFormatter.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================
         Section header (used between content blocks)
         ============================================================ -->
    <Style x:Key="DetailSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource H2TextStyle}">
        <Setter Property="Margin" Value="0,24,0,12" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Reusable label / value pair for the details grid -->
    <DataTemplate x:Key="DetailKeyValueTemplate">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Key}"
                       Style="{StaticResource MutedTextStyle}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Value, FallbackValue='—', TargetNullValue='—'}"
                       Style="{StaticResource BodyTextStyle}" />
        </Grid>
    </DataTemplate>

    <!-- Tag chip for genres / features / platforms -->
    <DataTemplate x:Key="NamedTagTemplate">
        <Border Style="{StaticResource TagChipStyle}">
            <TextBlock Text="{Binding Name, FallbackValue=''}"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>
    </DataTemplate>

    <!-- ============================================================
         Main template
         ============================================================ -->
    <ControlTemplate x:Key="GameDetailsTemplate" TargetType="ContentControl">
        <Grid Background="{DynamicResource BgDeepBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- Outer wrapper: fades view in on Loaded; MaxWidth keeps
                     content readable on ultrawide / 4K displays. -->
                <Grid HorizontalAlignment="Stretch">
                    <Grid.Style>
                        <Style TargetType="Grid" BasedOn="{StaticResource FadeInOnLoadedStyle}" />
                    </Grid.Style>
                <StackPanel MaxWidth="1600"
                            HorizontalAlignment="Center">

                    <!-- ====== 1. HERO ====== -->
                    <Grid MinHeight="420">
                        <!-- Trailer / background fill -->
                        <ContentControl Style="{StaticResource TrailerPlayerStyle}"
                                        DataContext="{Binding}" />

                        <!-- Foreground: cover + meta. Sits on top of the gradient. -->
                        <Grid Margin="32,0,32,32"
                              VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cover -->
                            <Border Grid.Column="0"
                                    Width="220"
                                    Height="320"
                                    CornerRadius="{StaticResource CornerRadiusMedium}"
                                    Background="{DynamicResource BgPanelBrush}"
                                    ClipToBounds="True"
                                    Margin="0,0,28,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24"
                                                      ShadowDepth="0"
                                                      Opacity="0.6"
                                                      Color="#000000" />
                                </Border.Effect>
                                <Image Source="{Binding Game.CoverImage,
                                                        FallbackValue={x:Null},
                                                        TargetNullValue={x:Null}}"
                                       Stretch="UniformToFill" />
                            </Border>

                            <!-- Title + summary block -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Game.Name,
                                                          FallbackValue='Unknown Title',
                                                          TargetNullValue='Unknown Title'}"
                                           Style="{StaticResource GameTitleTextStyle}"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- Release date · developer -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Game.ReleaseDate,
                                                              StringFormat={}{0:yyyy},
                                                              FallbackValue='—',
                                                              TargetNullValue='—'}"
                                               Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Text=" · "
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="6,0,6,0" />
                                    <ItemsControl ItemsSource="{Binding Game.Developers,
                                                                        FallbackValue={x:Null},
                                                                        TargetNullValue={x:Null}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, FallbackValue=''}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Margin="0,0,8,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Genre chips -->
                                <ItemsControl ItemsSource="{Binding Game.Genres,
                                                                    FallbackValue={x:Null},
                                                                    TargetNullValue={x:Null}}"
                                              ItemTemplate="{StaticResource NamedTagTemplate}"
                                              Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ====== 2. ACTION BAR ====== -->
                    <Border Background="{DynamicResource BgPanelBrush}"
                            Padding="32,18,32,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource PrimaryPlayButtonStyle}"
                                    Content="PLAY"
                                    Command="{Binding StartGameCommand,
                                                      FallbackValue={x:Null},
                                                      TargetNullValue={x:Null}}"
                                    CommandParameter="{Binding Game}" />

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="INSTALL"
                                        Margin="8,0,0,0"
                                        Command="{Binding InstallGameCommand,
                                                          FallbackValue={x:Null},
                                                          TargetNullValue={x:Null}}"
                                        CommandParameter="{Binding Game}" />
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Content="EDIT"
                                        Margin="8,0,0,0"
                                        Command="{Binding EditGameCommand,
                                                          FallbackValue={x:Null},
                                                          TargetNullValue={x:Null}}"
                                        CommandParameter="{Binding Game}" />
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Content="MORE"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ====== 3. HLTB PANEL ====== -->
                    <StackPanel Margin="32,0,32,0">
                        <TextBlock Text="HOW LONG TO BEAT"
                                   Style="{StaticResource DetailSectionHeaderStyle}" />
                        <ContentControl Style="{StaticResource HltbPanelStyle}"
                                        DataContext="{Binding Game,
                                                              FallbackValue={x:Null},
                                                              TargetNullValue={x:Null}}" />
                    </StackPanel>

                    <!-- ====== 4. DESCRIPTION ====== -->
                    <StackPanel Margin="32,0,32,0">
                        <TextBlock Text="ABOUT"
                                   Style="{StaticResource DetailSectionHeaderStyle}" />
                        <Border Background="{DynamicResource BgPanelBrush}"
                                CornerRadius="{StaticResource CornerRadiusMedium}"
                                Padding="20,16,20,16">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <TextBlock Text="Read more"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{DynamicResource AccentBlueBrush}" />
                                </Expander.Header>
                                <ScrollViewer MaxHeight="320"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Game.Description,
                                                              FallbackValue='No description available.',
                                                              TargetNullValue='No description available.'}"
                                               Style="{StaticResource BodyTextStyle}" />
                                </ScrollViewer>
                            </Expander>
                        </Border>
                    </StackPanel>

                    <!-- ====== 5. SCREENSHOTS ====== -->
                    <StackPanel Margin="32,0,32,0">
                        <TextBlock Text="MEDIA"
                                   Style="{StaticResource DetailSectionHeaderStyle}" />
                        <ContentControl Style="{StaticResource ScreenshotCarouselStyle}"
                                        DataContext="{Binding Game.Screenshots,
                                                              FallbackValue={x:Null},
                                                              TargetNullValue={x:Null}}" />
                    </StackPanel>

                    <!-- ====== 6. DETAILS GRID ====== -->
                    <StackPanel Margin="32,0,32,40">
                        <TextBlock Text="DETAILS"
                                   Style="{StaticResource DetailSectionHeaderStyle}" />
                        <Border Background="{DynamicResource BgPanelBrush}"
                                CornerRadius="{StaticResource CornerRadiusMedium}"
                                Padding="20,16,20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left column -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Genres" Style="{StaticResource MutedTextStyle}" />
                                        <ItemsControl Grid.Column="1"
                                                      ItemsSource="{Binding Game.Genres,
                                                                            FallbackValue={x:Null},
                                                                            TargetNullValue={x:Null}}"
                                                      ItemTemplate="{StaticResource NamedTagTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Features" Style="{StaticResource MutedTextStyle}" />
                                        <ItemsControl Grid.Column="1"
                                                      ItemsSource="{Binding Game.Features,
                                                                            FallbackValue={x:Null},
                                                                            TargetNullValue={x:Null}}"
                                                      ItemTemplate="{StaticResource NamedTagTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Platforms" Style="{StaticResource MutedTextStyle}" />
                                        <ItemsControl Grid.Column="1"
                                                      ItemsSource="{Binding Game.Platforms,
                                                                            FallbackValue={x:Null},
                                                                            TargetNullValue={x:Null}}"
                                                      ItemTemplate="{StaticResource NamedTagTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>

                                <!-- Right column -->
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Released" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Game.ReleaseDate,
                                                                  StringFormat={}{0:yyyy-MM-dd},
                                                                  FallbackValue='—',
                                                                  TargetNullValue='—'}"
                                                   Style="{StaticResource BodyTextStyle}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Playtime" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Game.Playtime,
                                                                  StringFormat={StaticResource PlaytimeSecondsFormat},
                                                                  FallbackValue='0',
                                                                  TargetNullValue='0'}"
                                                   Style="{StaticResource BodyTextStyle}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Last played" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Game.LastActivity,
                                                                  StringFormat={}{0:yyyy-MM-dd},
                                                                  FallbackValue='—',
                                                                  TargetNullValue='—'}"
                                                   Style="{StaticResource BodyTextStyle}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Source" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Game.Source.Name,
                                                                  FallbackValue='—',
                                                                  TargetNullValue='—'}"
                                                   Style="{StaticResource BodyTextStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </ControlTemplate>

    <Style x:Key="GameDetailsStyle" TargetType="ContentControl">
        <Setter Property="Template" Value="{StaticResource GameDetailsTemplate}" />
    </Style>

</ResourceDictionary>
