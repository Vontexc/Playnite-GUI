<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         SteamLike – global theme resource dictionary.
         Order matters: Colors must load before TextStyles before Buttons,
         since later dictionaries reference earlier tokens.
         ============================================================ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/Colors.xaml" />
        <ResourceDictionary Source="Styles/TextStyles.xaml" />
        <ResourceDictionary Source="Styles/Buttons.xaml" />
        <ResourceDictionary Source="Styles/Controls.xaml" />
        <ResourceDictionary Source="Styles/Placeholders.xaml" />
        <ResourceDictionary Source="Styles/Animations.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
