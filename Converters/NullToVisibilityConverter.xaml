<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         NullToVisibility – pure-XAML null-handling.
         ============================================================
         WPF's IValueConverter cannot be implemented in XAML, so we
         provide attached Styles using DataTriggers that achieve the
         same effect without any code-behind.

         Apply via:
             <Border Style="{StaticResource HideIfNullStyle}"
                     DataContext="{Binding SomePossiblyNullValue}" />

         Or for the inverse (show only when not null):
             <TextBlock Text="{Binding Game.Description}"
                        Style="{StaticResource ShowIfNotNullStyle}"
                        DataContext="{Binding Game.Description}" />

         Note: the trigger checks whether the entire DataContext is null,
         which is why callers re-bind DataContext to the value to be
         tested. For empty-string handling pair with HideIfEmptyStringStyle.
         ============================================================ -->

    <!-- Visible when DataContext != null, Collapsed when null. -->
    <Style x:Key="ShowIfNotNullStyle" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Inverse: Collapsed when DataContext != null, Visible when null. -->
    <Style x:Key="HideIfNotNullStyle" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Hide when bound string is empty. -->
    <Style x:Key="HideIfEmptyStringStyle" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- TextBlock-typed convenience variants (TextBlock is sealed in the
         visual tree for some ItemsControls and won't accept the generic
         FrameworkElement style). -->
    <Style x:Key="HideIfEmptyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
