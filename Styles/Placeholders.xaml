<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Vector placeholders for missing artwork.
         Pure XAML – no bitmap dependencies. Used by GameCoverCard and
         the GameDetails hero when an image source is null.

         All shapes derive their colors from the theme palette tokens,
         so the Light/Dark switch (future) stays in sync automatically.
         ============================================================ -->

    <!-- Game-pad silhouette path data (centered ~64x64 viewbox). -->
    <Geometry x:Key="ControllerIconGeometry">
        M14 22 C8 22 4 26 4 32 L4 44 C4 50 8 54 14 54 C18 54 20 52 22 50 L42 50 C44 52 46 54 50 54
        C56 54 60 50 60 44 L60 32 C60 26 56 22 50 22 Z
        M16 30 L16 36 M13 33 L19 33
        M44 32 A2 2 0 1 1 44 32 Z
        M50 38 A2 2 0 1 1 50 38 Z
    </Geometry>

    <!-- Placeholder used inside the cover card / hero when no image. -->
    <DataTemplate x:Key="MissingCoverPlaceholderTemplate">
        <Grid Background="{DynamicResource HeroGradientBrush}">
            <Viewbox Width="80" Height="80"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Opacity="0.55">
                <Path Data="{StaticResource ControllerIconGeometry}"
                      Fill="{DynamicResource AccentBlueBrush}"
                      Stretch="Uniform" />
            </Viewbox>
            <TextBlock Text="{Binding Name,
                                      FallbackValue='No cover',
                                      TargetNullValue='No cover'}"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="14,0,14,18"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Grid>
    </DataTemplate>

    <!-- Placeholder for the GameDetails hero when no BackgroundImage. -->
    <DataTemplate x:Key="MissingBackgroundPlaceholderTemplate">
        <Grid>
            <Rectangle Fill="{DynamicResource HeroGradientBrush}" />
            <!-- Subtle diagonal accent stripe -->
            <Rectangle Width="2"
                       Fill="{DynamicResource AccentBlueBrush}"
                       Opacity="0.35"
                       HorizontalAlignment="Left"
                       Margin="200,0,0,0">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="20" CenterX="0" CenterY="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </DataTemplate>

    <!-- Reusable Style: shows the controller placeholder behind any
         null-source Image. Apply to a Border that wraps the Image. -->
    <Style x:Key="CoverContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

</ResourceDictionary>
